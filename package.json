{
  "name": "kin-site",
  "version": "0.1.0",
  "description": "Kin — a private, collaborative family tree for the Macartney / Davies / Fahey line",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema": "tsx scripts/apply-schema.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:lissanoure": "tsx scripts/seed-lissanoure.ts",
    "seed:checklist": "tsx scripts/seed-checklist.ts",
    "invite": "tsx scripts/create-invite.ts",
    "demo": "tsx scripts/demo.ts",
    "dump": "tsx scripts/dump-data.ts",
    "restore": "tsx scripts/restore-data.ts",
    "e2e": "tsx scripts/e2e-local.ts"
  },
  "dependencies": {
    "next": "^15.5.25",
    "postgres": "^3.4.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
